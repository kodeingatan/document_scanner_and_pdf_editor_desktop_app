{
  "name": "document-scanner-pdf-editor",
  "version": "1.0.0",
  "description": "Professional offline desktop document digitization suite: scanner, image processing, PDF editor and converter.",
  "author": "Document Scanner & PDF Editor",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.electron.json",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "prepare:assets": "node scripts/fetch-tessdata.mjs",
    "dist": "npm run build && node scripts/package.mjs --win",
    "pack": "npm run build && node scripts/package.mjs --win --dir"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@napi-rs/canvas": "^0.1.65",
    "docx": "^9.1.1",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^3.12.0",
    "sql.js": "^1.13.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2",
    "lucide-react": "^0.469.0",
    "clsx": "^2.1.1"
  }
}
